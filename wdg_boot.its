/*
 * Simple U-Boot uImage source file containing a single kernel and FDT blob
 */

/dts-v1/;

/ {
	description = "u-boot uImage source file for s5pv210 wdg";
	#address-cells = <1>;

	images {
		kernel {
			description = "s5pv210 wdg Linux kernel";
			data = /incbin/("./arch/arm/boot/zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x20000000>;
			entry = <0x20000000>;
			hash-1 {
				algo = "crc32";
			};
			hash-2 {
				algo = "sha1";
			};
		};
		fdt-1 {
			description = "Flattened Device Tree for s5pv210 wdg";
			data = /incbin/("./arch/arm/boot/dts/s5pv210-wdg.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
			hash-2 {
				algo = "sha1";
			};
		};
	};

	configurations {
		default = "conf-1";
		conf-1 {
			description = "Boot Linux kernel with FDT blob for s5pv210 wdg";
			kernel = "kernel";
			fdt = "fdt-1";
		};
	};
};
